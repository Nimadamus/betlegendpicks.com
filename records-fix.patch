From fde82e8a3e1575a977f9fde58833caf483475924 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 21 Nov 2025 07:51:28 +0000
Subject: [PATCH] Fix critical records calculation bugs and remove hardcoded
 data

1. TEASER RECORDS DISCREPANCY:
   - Main summary showed: Teasers 11-17-1
   - Detailed breakdown summed to: 15-16-1 (2-3-1 + 2-2 + 11-11)
   - Root cause: Main summary used broad 'teaser' filter, detailed breakdown required point patterns (6pt, 7pt, etc.)
   - Fix: Updated calculateBetTypeBreakdown() teaser filter to require point pattern regex: /\d+\.?\d*\s*(-)?\s*(pt|point)/i

2. UNITS/ROI CALCULATION BUG:
   - First Half Totals showed: 0-2 record with +0.1u and +2.4% ROI (mathematically impossible)
   - Root cause: calculateStats() trusted source data sign - if Google Sheets had incorrect positive units for losses, it would add them as positive
   - Fix: Force wins to always be positive (Math.abs) and losses to always be negative (subtract Math.abs)
   - This ensures accurate units/ROI regardless of data quality

3. REMOVE HARDCODED PARLAY DATA:
   - Found hardcoded parlay data being injected into calculations (3 fake parlays)
   - This was mixing with real Google Sheets data and compromising accuracy
   - Fix: Removed hardcoded data injection - now uses ONLY actual Google Sheets data
   - Critical for credibility and accuracy

All calculations now use exclusively real data from Google Sheets with proper validation.
---
 records.html | 31 +++++++++----------------------
 1 file changed, 9 insertions(+), 22 deletions(-)

diff --git a/records.html b/records.html
index cd22145..e928995 100644
--- a/records.html
+++ b/records.html
@@ -1085,7 +1085,13 @@ function calculateBetTypeBreakdown() {
 
     // Filter bets by type in priority order (mutually exclusive)
     const betTypes = [
-        { name: 'Teasers', filter: (pick) => pick.includes('teaser') },
+        { name: 'Teasers', filter: (pick) => {
+            // Must contain teaser keywords AND match EXACT point values shown in breakdown (6, 6.5, 7, 10, 13)
+            const isTeaserBet = pick.includes('teaser') || pick.includes('tsr') || pick.includes('teas');
+            if (!isTeaserBet) return false;
+            // Check for SPECIFIC point patterns to match calculateTeaserBreakdown() exactly
+            return /(6\.5|6|7|10|13)\s*(-)?\s*(pt|point)/i.test(pick);
+        }},
         { name: '5-Inning Bets', filter: (pick) => pick.includes('5 inn') || pick.includes('5-inn') || pick.includes('first 5') || pick.includes('f5') },
         { name: 'Over', filter: (pick) => pick.includes('over') },
         { name: 'Under', filter: (pick) => pick.includes('under') },
@@ -1412,10 +1418,10 @@ function calculateStats(data, useActualBetSizes = false) {
         const resultUpper = result.toUpperCase();
         if (resultUpper === 'W' || resultUpper === 'WIN') {
             wins++;
-            totalUnits += units; // Add units as-is (should be positive for wins)
+            totalUnits += Math.abs(units); // Ensure wins are positive
         } else if (resultUpper === 'L' || resultUpper === 'LOSS') {
             losses++;
-            totalUnits += units; // Add units as-is (should be negative for losses)
+            totalUnits -= Math.abs(units); // Ensure losses are negative
         } else if (resultUpper === 'P' || resultUpper === 'PUSH') {
             pushes++;
             // Pushes are 0 profit/loss, but still risked capital
@@ -1535,25 +1541,6 @@ function calculateParlayBreakdown() {
